# ==========================================
# Application
# ==========================================

NUM_PSU=6
MAX_HIST=800
POLL_MS=5000
AUTO_SAVE_INTERVAL=60
PSU_START_RAMP_SECONDS=4.0


OPEN_FUSE_CURRENT_THRESHOLD_A = 0.010
OPEN_FUSE_CONSECUTIVE_POLLS = 3
OPEN_FUSE_STARTUP_GRACE_SECONDS = 10.0

# ==========================================
# PSU network configuration
# ==========================================

PSU_1_IP_ADDRESS=169.254.10.10
PSU_2_IP_ADDRESS=
PSU_3_IP_ADDRESS=
PSU_4_IP_ADDRESS=
PSU_5_IP_ADDRESS=
PSU_6_IP_ADDRESS=


# ==========================================
# SQLite test database
# ==========================================

SQLITE_DATABASE_PATH=data/htol_monitor.db

# Store one historical measurement every 10 seconds
DB_SAMPLE_INTERVAL_SECONDS=10

# Flush buffered measurements every 30 seconds
DB_BATCH_FLUSH_SECONDS=30

# ==========================================
# UI development mode
# ==========================================

UI_TEST_MODE=false